{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "movie.levelup-ecosystem.com" }],
      "destination": "/movie.html"
    },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "music.levelup-ecosystem.com" }],
      "destination": "/music.html"
    },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "ia.levelup-ecosystem.com" }],
      "destination": "/ia.html"
    },
    {
      "source": "/__/auth/:path*",
      "destination": "https://levelup-ia.firebaseapp.com/__/auth/:path*"
    },
    { 
      "source": "/api/:path*", 
      "destination": "/api/:path*" 
    },
    { 
      "source": "/(.*)", 
      "destination": "/index.html" 
    }
  ],
  "functions": {
    "api/*.js": {
      "memory": 256,
      "maxDuration": 10
    }
  }
}
