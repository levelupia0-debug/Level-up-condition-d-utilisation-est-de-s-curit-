{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "movie.levelup-ecosystem.com" }],
      "destination": "/movie.html",
      "permanent": false
    },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "music.levelup-ecosystem.com" }],
      "destination": "/music.html",
      "permanent": false
    },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "ia.levelup-ecosystem.com" }],
      "destination": "/ia.html",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/__/auth/:path*",
      "destination": "https://levelup-ia.firebaseapp.com/__/auth/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/:path*"
    },
    {
      "source": "/levelday",
      "destination": "/levelday.html"
    },
    {
      "source": "/login",
      "destination": "/login.html"
    },
    {
      "source": "/anime",
      "destination": "/anime.html"
    },
     {
      "source": "/dona",
      "destination": "/dona.html"
    },
    {
      "source": "/dashboard",
      "destination": "/dashboard.html"
    },
    {
      "source": "/movie-hub",
      "destination": "/movie-hub.html"
    },
    {
      "source": "/music-hub",
      "destination": "/music-hub.html"
    },
    {
      "source": "/game",
      "destination": "/game.html"
    },
    {
      "source": "/otaku",
      "destination": "/otaku.html"
    },
    {
      "source": "/:path*",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/*.js": {
      "memory": 256,
      "maxDuration": 10
    }
  }
}
