{
  "rewrites": [
    {
      "source": "/",
      "has": [
        { "type": "host", "value": "movie.levelup-ecosystem.com" }
      ],
      "destination": "/movie.html"
    },
    {
      "source": "/",
      "has": [
        { "type": "host", "value": "music.levelup-ecosystem.com" }
      ],
      "destination": "/music.html"
    },
    {
      "source": "/",
      "has": [
        { "type": "host", "value": "ia.levelup-ecosystem.com" }
      ],
      "destination": "/ia.html"
    },
    {
      "source": "/(.*)",
      "destination": "/$1"
    }
  ]
}
