{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/__/auth/:path*",
      "destination": "https://levelup-ia.firebaseapp.com/__/auth/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/:path*"
    },
    {
      "source": "/levelday",
      "destination": "/levelday.html"
    },
    {
      "source": "/oppa",
      "destination": "/oppa.html"
    },
    {
      "source": "/mobile",
      "destination": "/mobile.html"
    },
    {
      "source": "/tabaski",
      "destination": "/tabaski.html"
    },   
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/dernier-retrouvailles",
      "destination": "/dernier-retrouvailles.html"
    },
    {
      "source": "/dona",
      "destination": "/dona.html"
    },
    {
      "source": "/organisateur",
      "destination": "organisateur.html"
    },
    {
      "source": "/movie-hub",
      "destination": "/movie-hub.html"
    },
    {
      "source": "/music-hub",
      "destination": "/music-hub.html"
    },
    {
      "source": "/game",
      "destination": "/game.html"
    },
    {
      "source": "/otaku",
      "destination": "/otaku.html"
    },
    {
      "source": "/movie",
      "destination": "/movie.html"
    },
    {
      "source": "/music",
      "destination": "/music.html"
    },
    {
      "source": "/tool",
      "destination": "/tool.html"
    },
    {
      "source": "/:path*",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/**/*.js": {
      "memory": 512,
      "maxDuration": 10
    }
  }
}
