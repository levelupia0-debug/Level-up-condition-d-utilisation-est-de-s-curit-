{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/__/auth/:path*", "destination": "https://levelup-ia.firebaseapp.com/__/auth/:path*" },
    { "source": "/api/:path*", "destination": "/api/:path*" },
    { "source": "/levelday", "destination": "/levelday.html" },
    { "source": "/anime", "destination": "/anime.html" },
    { "source": "/dona", "destination": "/dona.html" },
    { "source": "/movie-hub", "destination": "/movie-hub.html" },
    { "source": "/music-hub", "destination": "/music-hub.html" },
    { "source": "/game", "destination": "/game.html" },
    { "source": "/otaku", "destination": "/otaku.html" },
    { "source": "/movie", "destination": "/movie.html" },
    { "source": "/music", "destination": "/music.html" },
    { "source": "/:path*", "destination": "/index.html" }
  ],
  "functions": {
    "api/*.js": {
      "memory": 256,
      "maxDuration": 10
    }
  }
}
