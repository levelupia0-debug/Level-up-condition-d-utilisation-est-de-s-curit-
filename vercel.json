{
  "cleanUrls": true,
  "redirects": [
    // ... tes redirections de sous-domaines (movie, music, ia)
  ],
  "rewrites": [
    {
      "source": "/__/auth/:path*",
      "destination": "https://levelup-ia.firebaseapp.com/__/auth/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/:path*"
    },
    {
      "source": "/levelday",
      "destination": "/levelday.html"
    },
    {
      "source": "/login",
      "destination": "/login.html"
    },
    {
      "source": "/anime",
      "destination": "/anime.html"
    },
    {
      "source": "/:path*",
      "destination": "/index.html"
    }
  ]
}
