{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/",
      "has": [
        { "type": "host", "value": "movie.levelup-ecosystem.com" }
      ],
      "destination": "/movie.html",
      "permanent": false
    },
    {
      "source": "/",
      "has": [
        { "type": "host", "value": "music.levelup-ecosystem.com" }
      ],
      "destination": "/music.html",
      "permanent": false
    },
    {
      "source": "/",
      "has": [
        { "type": "host", "value": "ia.levelup-ecosystem.com" }
      ],
      "destination": "/ia.html",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/__/auth/:path*",
      "destination": "https://levelup-ia.firebaseapp.com/__/auth/:path*"
    }
  ],
  "functions": {
    "api/*.js": {
      "memory": 256,
      "maxDuration": 10
    }
  }
}
